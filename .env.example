BOT_TOKEN=
BOT_USERNAME=
ADMIN_CHAT_IDS=
# Главный адрес ссылок в боте и QR-кодах. Production: https://nvate.uz
BASE_URL=http://localhost:3000
PORT=3000
DEV_NO_AUTH=0
# Blank for local SQLite; Railway requires its private PostgreSQL reference.
DATABASE_URL=
# Railway persistent volume mount (production: /data).
NVATE_DATA_DIR=data
# Optional: YouTube Data API v3 key for music search. Without it the studio
# searches the youtube.com results page.
YOUTUBE_API_KEY=
# Magic import: audio from links (YouTube, TikTok, Instagram…) and from videos.
# The Docker image ships yt-dlp and ffmpeg; locally point to the binaries.
YTDLP_BIN=
FFMPEG_BIN=
# If YouTube asks the datacenter IP to "confirm you're not a bot": a residential
# proxy (http://user:pass@host:port) and/or Netscape cookies (file path, text or base64).
YTDLP_PROXY=
YTDLP_COOKIES=
# JS runtime yt-dlp uses for YouTube (node is in the image); "none" to omit.
YTDLP_JS_RUNTIME=node
# Storage of already-chosen nVate library songs (legacy invitations keep playing):
# local (uploads on the volume, default) or s3. Credentials stay server-side.
MUSIC_STORAGE=local
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com ; region "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public bucket domain; without it the server hands out signed links.
S3_PUBLIC_URL=
# Lifetime of signed links in seconds (default 43200).
S3_URL_TTL=
# Optional: Audius API (public, no key). App name identifies nVate to Audius.
AUDIUS_API_URL=
AUDIUS_APP_NAME=nvate
# One-time SQLite import; source is retained and repeat imports are skipped.
# NVATE_MIGRATE_SQLITE=/data/wedding.db
