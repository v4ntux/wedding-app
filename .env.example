BOT_TOKEN=
BOT_USERNAME=
ADMIN_CHAT_IDS=
# Главный адрес ссылок в боте и QR-кодах. Production: https://nvate.uz
BASE_URL=http://localhost:3000
PORT=3000
DEV_NO_AUTH=0
# Blank for local SQLite; Railway requires its private PostgreSQL reference.
DATABASE_URL=
# Railway persistent volume mount (production: /data).
NVATE_DATA_DIR=data
# Optional: YouTube Data API v3 key for music search. Without it the studio
# searches the youtube.com results page.
YOUTUBE_API_KEY=
# Optional: yt-dlp path. The Docker image ships yt-dlp in PATH; without it the
# studio plays YouTube songs through the YouTube player, without the waveform.
YTDLP_BIN=
# Optional: cookies.txt contents (Netscape format) if YouTube asks the server
# to confirm it is not a bot. Use a spare account.
YTDLP_COOKIES=
# One-time SQLite import; source is retained and repeat imports are skipped.
# NVATE_MIGRATE_SQLITE=/data/wedding.db
